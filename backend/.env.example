# =============================================================================
# Backend environment variables — copy to .env.local and fill in real values.
# =============================================================================

# -----------------------------------------------------------------------------
# LiveKit (real-time transport)
# Get these from https://cloud.livekit.io/ → your project → Settings
# -----------------------------------------------------------------------------
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key_here
LIVEKIT_API_SECRET=your_livekit_api_secret_here

# -----------------------------------------------------------------------------
# Murf (TTS — Text-to-Speech)
# Get your API key from https://murf.ai/api/dashboard
# -----------------------------------------------------------------------------
MURF_API_KEY=your_murf_api_key_here

# -----------------------------------------------------------------------------
# Deepgram (STT — Speech-to-Text)
# Get your API key from https://deepgram.com
# -----------------------------------------------------------------------------
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# -----------------------------------------------------------------------------
# LLM — use one of the following depending on which provider you use
# -----------------------------------------------------------------------------
# For Gemini (default): get from https://aistudio.google.com/apikey
GOOGLE_API_KEY=your_google_api_key_here

# Groq (primary LLM — llama-3.3-70b-versatile): https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# For OpenAI: get from https://platform.openai.com/api-keys (if using OpenAI LLM)
# OPENAI_API_KEY=your_openai_api_key_here

# NVIDIA NIM (OpenAI-compatible) — LLM fallback
NVIDIA_API_KEY=your_nvidia_api_key_here

# -----------------------------------------------------------------------------
# Telephony — outbound calls (Day 6). One-time setup, see backend/README.md:
#   1. Twilio Console → Elastic SIP Trunking → trunk + credential list + number
#   2. lk sip outbound create --name careva-outbound --address <trunk>.pstn.twilio.com \
#        --number +1XXXXXXXXXX --auth-user "$SIP_AUTH_USERNAME" --auth-pass "$SIP_AUTH_PASSWORD"
#   3. Paste the printed SIPTrunkID below
# -----------------------------------------------------------------------------
SIP_OUTBOUND_TRUNK_ID=ST_your_trunk_id_here

# Twilio credential-list username/password (only needed when creating the trunk)
SIP_AUTH_USERNAME=your_twilio_sip_username_here
SIP_AUTH_PASSWORD=your_twilio_sip_password_here
